# Runtime environment
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# SQLite database path
DATABASE_PATH=./data/webhook-relay.db

# Encryption key for webhook signing secrets (32 hex chars = 16 bytes min)
ENCRYPTION_KEY=change-me-to-a-random-32-char-hex-string

# Admin API key for protected endpoints
ADMIN_API_KEY=

# MCP transport: stdio (default) or sse
MCP_TRANSPORT=stdio

# MCP API key for HTTP transport client authentication (optional; if unset, all requests allowed)
MCP_API_KEY=

# Pino log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
LOG_FORMAT=json

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Public webhook base URL (for generating webhook endpoints)
WEBHOOK_BASE_URL=http://localhost:3000

# Event retention in days
EVENT_RETENTION_DAYS=30

# Metrics
METRICS_ENABLED=true

# Delivery retry configuration
DELIVERY_RETRY_MAX=5
DELIVERY_RETRY_BACKOFF_MS=1000

# Source heartbeat check interval in minutes
SOURCE_HEARTBEAT_MINUTES=60
