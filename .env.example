# Runtime environment
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# SQLite database path
DATABASE_PATH=./data/webhook-relay.db

# Encryption key for webhook signing secrets (32 hex chars = 16 bytes min)
ENCRYPTION_KEY=change-me-to-a-random-32-char-hex-string

# Admin API key for protected endpoints
ADMIN_API_KEY=

# MCP transport: stdio (default) or http
MCP_TRANSPORT=stdio

# Pino log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
LOG_FORMAT=json

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Public webhook base URL (for generating webhook endpoints)
WEBHOOK_BASE_URL=http://localhost:3000

# Event retention in days
EVENT_RETENTION_DAYS=30
