{
  "name": "@reaatech/webhook-relay-storage",
  "version": "0.1.0",
  "description": "SQLite storage and persistence for webhook-relay-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/webhook-relay-mcp.git",
    "directory": "packages/storage"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/webhook-relay-core": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.6.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
