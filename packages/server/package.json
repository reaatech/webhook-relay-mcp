{
  "name": "@reaatech/webhook-relay-mcp",
  "version": "0.2.0",
  "description": "HTTP server and entry point for webhook-relay-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/webhook-relay-mcp.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "webhook-relay-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/webhook-relay-core": "workspace:*",
    "@reaatech/webhook-relay-storage": "workspace:*",
    "@reaatech/webhook-relay-webhooks": "workspace:*",
    "@reaatech/webhook-relay-tools": "workspace:*",
    "express": "^5.2.1",
    "raw-body": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
