{
  "name": "@reaatech/webhook-relay-webhooks",
  "version": "0.1.0",
  "description": "Webhook sources, validators, and ingestion for webhook-relay-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/webhook-relay-mcp.git",
    "directory": "packages/webhooks"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/webhook-relay-core": "workspace:*",
    "@reaatech/webhook-relay-storage": "workspace:*",
    "express": "^5.2.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
