{
  "name": "webhook-relay-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade MCP server for webhook ingestion and event relay",
  "type": "module",
  "keywords": ["mcp", "webhook", "stripe", "github", "replicate", "twilio"],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/webhook-relay-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/webhook-relay-mcp/issues"
  },
  "homepage": "https://github.com/reaatech/webhook-relay-mcp#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^3.1.1",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
